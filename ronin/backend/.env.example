# Application
NODE_ENV=development
PORT=5000
SESSION_SECRET=your-32-characters-secret-key-minimum-here-change-me
DEFAULT_LOCALE=ru
SUPPORTED_LOCALES=ky,ru,en
FRONTEND_URL=http://localhost:3000

# Neon PostgreSQL
DATABASE_URL="postgresql://your-username:your-password@ep-xxx-region.aws.neon.tech/ronin?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://your-username:your-password@ep-xxx-region.aws.neon.tech/ronin?sslmode=require"

# Redis (optional)
# REDIS_URL=redis://localhost:6379

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# SMS Provider (optional)
SMS_PROVIDER=custom
# SMS_API_KEY=your-api-key
# SMS_API_SECRET=your-api-secret
# SMS_SENDER_ID=RONIN

# Email Provider (optional)
EMAIL_PROVIDER=nodemailer
# EMAIL_API_KEY=your-api-key
EMAIL_FROM=noreply@ronin.kg

# Payment Provider (optional)
PAYMENT_PROVIDER=custom
# PAYMENT_API_KEY=your-api-key
# PAYMENT_API_SECRET=your-api-secret
# PAYMENT_WEBHOOK_SECRET=your-webhook-secret
# PAYMENT_MERCHANT_ID=your-merchant-id
# PAYMENT_RETURN_URL=http://localhost:5000/api/payments/return
# PAYMENT_CANCEL_URL=http://localhost:5000/api/payments/cancel

# S3 Storage (optional)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=ronin-club
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_PUBLIC_BASE_URL=https://cdn.ronin.kg

# AI Provider (optional)
AI_PROVIDER=none
# OPENAI_API_KEY=your-api-key
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=your-api-key
# GEMINI_MODEL=gemini-pro

# Cron (optional)
CRON_SECRET=your-32-characters-secret-key-minimum-here-change-me

# Logger
LOG_LEVEL=info
