generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ==========================================
// USERS & AUTHENTICATION
// ==========================================

model User {
  id               Int      @id @default(autoincrement())
  email            String?  @unique
  phone            String?  @unique
  firstName        String
  lastName         String
  passwordHash     String?  @map("password_hash")
  role             String   @default("CUSTOMER")
  isPhoneVerified  Boolean  @default(false)
  isActive         Boolean  @default(true)
  locale           String   @default("ru")
  characterId      Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("users")
}

// ==========================================
// CHARACTERS (GAME CHARACTERS)
// ==========================================

model Character {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  imageUrl    String?   @map("image_url")
  price       Int       // in KGS (cents)
  isFree      Boolean   @default(false)
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("characters")
}

// ==========================================
// COMPUTER CLUB - CATEGORIES & COMPUTERS
// ==========================================

model ComputerCategory {
  id          Int       @id @default(autoincrement())
  name        String
  nameKy      String?   @map("name_ky")
  nameEn      String?   @map("name_en")
  description String?   @map("description")
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("computer_categories")
}

model Computer {
  id           Int            @id @default(autoincrement())
  number       Int            @unique
  categoryId   Int
  specifications String?      @map("specifications")
  equipment    String?        @map("equipment")
  imageUrl     String?        @map("image_url")
  status       String         @default("AVAILABLE")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([number])
  @@map("computers")
}

// ==========================================
// PRICING & TARIFFS
// ==========================================

model Tariff {
  id              Int       @id @default(autoincrement())
  name            String
  nameKy          String?   @map("name_ky")
  nameEn          String?   @map("name_en")
  description     String?   @map("description")
  durationMinutes Int       @map("duration_minutes")
  price           Int       // in KGS (cents)
  categoryId      Int
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([categoryId, isActive])
  @@index([isActive])
  @@map("tariffs")
}

// ==========================================
// BOOKINGS
// ==========================================

model Booking {
  id              Int             @id @default(autoincrement())
  userId          Int
  computerId      Int
  tariffId        Int
  startsAt        DateTime
  endsAt          DateTime
  totalAmount     Int             @map("total_amount")
  status          String          @default("PENDING_PAYMENT")
  paymentMethod   String          @default("ONLINE")
  paymentId       Int?
  managerId       Int?
  isCashPayment   Boolean         @default(false)
  notes           String?         @map("notes")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([computerId])
  @@index([status])
  @@index([startsAt, endsAt])
  @@map("bookings")
}

// ==========================================
// PAYMENTS
// ==========================================

model Payment {
  id                Int             @id @default(autoincrement())
  userId            Int
  bookingId         Int?
  amount            Int             // in KGS (cents)
  currency          String          @default("KGS")
  provider          String          @default("CUSTOM")
  providerPaymentId String?         @map("provider_payment_id")
  status            String          @default("PENDING")
  transactionId     String?         @map("transaction_id")
  isIdempotent      Boolean         @default(false)
  idempotencyKey    String?         @unique @map("idempotency_key")
  providerRef       String?         @map("provider_ref")
  webhookReceived   Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId])
  @@index([bookingId])
  @@index([status])
  @@index([providerPaymentId])
  @@map("payments")
}

// ==========================================
// REFUNDS
// ==========================================

model Refund {
  id               Int          @id @default(autoincrement())
  paymentId        Int
  amount           Int          // in KGS (cents)
  reason           String
  refundedBy       Int          @map("refunded_by")
  status           String       @default("PENDING")
  providerRefundId String?      @map("provider_refund_id")
  isCashRefund     Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

// ==========================================
// RECEIPTS (ELECTRONIC RECEIPTS)
// ==========================================

model Receipt {
  id            Int          @id @default(autoincrement())
  bookingId     Int          @unique
  receiptNumber String       @unique @map("receipt_number")
  qrToken       String       @unique
  qrUrl         String?      @map("qr_url")
  amount        Int          // in KGS
  status        String       @default("VALID")
  isRefunded    Boolean      @default(false)
  refundedAt    DateTime?    @map("refunded_at")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("receipts")
}

// ==========================================
// GAMING SESSIONS
// ==========================================

model GamingSession {
  id          Int           @id @default(autoincrement())
  bookingId   Int
  computerId  Int
  startedAt   DateTime
  endedAt     DateTime?
  status      String        @default("ACTIVE")
  startedBy   Int           @map("started_by")
  endedBy     Int?          @map("ended_by")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([bookingId])
  @@index([computerId])
  @@index([status])
  @@map("gaming_sessions")
}

// ==========================================
// CMS (CONTENT MANAGEMENT SYSTEM)
// ==========================================

model CMSBlock {
  id          Int       @id @default(autoincrement())
  key         String    @unique
  title       String
  titleKy     String?   @map("title_ky")
  titleEn     String?   @map("title_en")
  type        String    @default("TEXT")
  content     String?
  contentKy   String?   @map("content_ky")
  contentEn   String?   @map("content_en")
  imageUrl    String?   @map("image_url")
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([key])
  @@index([isActive])
  @@map("cms_blocks")
}

model CMSCard {
  id            Int       @id @default(autoincrement())
  blockId       Int
  title         String
  titleKy       String?   @map("title_ky")
  titleEn       String?   @map("title_en")
  description   String?   @map("description")
  descriptionKy String?   @map("description_ky")
  descriptionEn String?   @map("description_en")
  imageUrl      String?   @map("image_url")
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([blockId])
  @@index([isActive])
  @@map("cms_cards")
}

model Quote {
  id          Int       @id @default(autoincrement())
  text        String
  textKy      String?   @map("text_ky")
  textEn      String?   @map("text_en")
  author      String?   @map("author")
  authorKy    String?   @map("author_ky")
  authorEn    String?   @map("author_en")
  imageUrl    String?   @map("image_url")
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
  @@map("quotes")
}

// ==========================================
// NOTIFICATIONS
// ==========================================

model Notification {
  id          Int         @id @default(autoincrement())
  userId      Int
  title       String
  titleKy     String?     @map("title_ky")
  titleEn     String?     @map("title_en")
  message     String
  messageKy   String?     @map("message_ky")
  messageEn   String?     @map("message_en")
  type        String      @default("OTHER")
  isRead      Boolean     @default(false)
  readAt      DateTime?   @map("read_at")
  link        String?
  createdAt   DateTime    @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ==========================================
// AI CONVERSATIONS
// ==========================================

model AIConversation {
  id              DateTime @id @default(now())
  userId          Int
  title           String?
  titleKy         String?    @map("title_ky")
  titleEn         String?    @map("title_en")
  lastMessageAt   DateTime   @map("last_message_at")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId])
  @@index([lastMessageAt])
  @@map("ai_conversations")
}

model AIMessage {
  id             Int        @id @default(autoincrement())
  conversationId Int
  role           String
  content        String
  contentKy      String?    @map("content_ky")
  contentEn      String?    @map("content_en")
  createdAt      DateTime   @default(now())

  @@index([conversationId])
  @@index([createdAt])
  @@map("ai_messages")
}

// ==========================================
// AUDIT LOGS
// ==========================================

model AuditLog {
  id          Int       @id @default(autoincrement())
  userId      Int?
  action      String
  actionKy    String?   @map("action_ky")
  actionEn    String?   @map("action_en")
  entityType  String    @map("entity_type")
  entityId    Int?
  details     String?
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
// SYSTEM
// ==========================================

model SystemSetting {
  id          Int       @id @default(autoincrement())
  key         String    @unique
  value       String?
  isSecret    Boolean   @default(false)
  description String?   @map("description")
  updatedAt   DateTime  @updatedAt

  @@map("system_settings")
}

model IdempotencyKey {
  id          Int        @id @default(autoincrement())
  key         String     @unique
  userId      Int?
  action      String
  payloadHash String     @map("payload_hash")
  result      String?
  expiresAt   DateTime
  createdAt   DateTime   @default(now())

  @@index([key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}